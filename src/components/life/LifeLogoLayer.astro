---
import asmlLogo from "../../content/general pics/ASML.png";
import azgLogo from "../../content/general pics/AZGCO.png";
import asmeLogo from "../../content/general pics/logo-asme.png";
import gasAtomization from "../../content/general pics/GasAtomization.png";
import MorpheidosTechLogo from "../layout/MorpheidosTechLogo.astro";

const maskStyle = (source: string) =>
    `--life-logo-mask: url("${source}")`;
---

<div
    class="life-logo-layer"
    data-life-logo-layer
    aria-hidden="true"
>
    <div
        class="life-logo-group life-logo-group--mechanical"
        data-life-logo-group
        data-stage-index="1"
    >
        <span
            class="life-logo-mark life-logo-mark--msc"
            style={maskStyle("/life-logo-masks/msc-mask.png")}
        ></span>
        <span class="life-logo-azg-orbit">
            <span
                class="life-logo-mark life-logo-mark--azg-base"
                style={maskStyle(azgLogo.src)}
            ></span>
            <span
                class="life-logo-mark life-logo-mark--azg-detail"
                style={maskStyle("/life-logo-masks/azg-mask.png")}
            ></span>
        </span>
        <span class="life-logo-asme-orbit">
            <span
                class="life-logo-mark life-logo-mark--asme"
                style={maskStyle(asmeLogo.src)}
            ></span>
        </span>
    </div>

    <div
        class="life-logo-group life-logo-group--polito"
        data-life-logo-group
        data-stage-index="2"
    >
        <span class="life-equation life-equation--continuum mono">
            ∇ · σ + b = ρa
        </span>
        <span class="life-equation life-equation--navier-stokes mono">
            <span class="life-equation-line">
                ρ(∂u/∂t + u · ∇u) =
            </span>
            <span class="life-equation-line">
                −∇p + μ∇²u + f
            </span>
        </span>
        <span class="life-equation life-equation--heat mono">
            ρc<sub>p</sub> ∂T/∂t = k∇²T + q̇
        </span>
        <span
            class="life-logo-mark life-logo-mark--polito"
            style={maskStyle("/life-logo-masks/polito-mask.png")}
        ></span>
    </div>

