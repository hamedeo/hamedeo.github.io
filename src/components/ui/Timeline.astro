---
export interface TimelineItemData {
    title: string;
    period: string;
    subtitle: string;
    location?: string;
    description?: string;
    thesis?: string;
    details?: string[];
    subDetails?: string[];
    subEntries?: Array<{
        title: string;
        subtitle?: string;
        period?: string;
        location?: string;
        description?: string;
    }>;
}

interface Props {
    items: TimelineItemData[];
}

const { items } = Astro.props;
---

<div class="timeline flex flex-col">
    {
        items.map((item) => (
            <div class="timeline-item flex gap-8 max-md:flex-col max-md:gap-0">
                <div class="timeline-marker flex flex-col items-center shrink-0 max-md:hidden" aria-hidden="true">
                    <div class="dot w-3 h-3 rounded-full bg-accent mt-2 z-10" />
                    <div class="timeline-line flex-1 w-[2px] bg-border my-2" />
                </div>
                <div class="timeline-content pb-8 flex-1 w-full">
                    <div class="entry-header flex justify-between items-start gap-4 mb-1 max-md:flex-col max-md:items-start max-md:gap-1">
                        <div class="min-w-0">
                            <h3 class="title-md transition-colors duration-200 break-words">
                                {item.title}
                            </h3>
                            <div class="body font-semibold opacity-90 break-words whitespace-normal">
                                {item.subtitle}
                            </div>
                        </div>
                        <div class="text-right flex flex-col items-end gap-1 max-md:items-start max-md:text-left">
                            {item.period && (
                                <span class="body-sm font-semibold opacity-75 whitespace-nowrap">
                                    {item.period}
                                </span>
                            )}
                            {item.location && (
                                <span class="body-sm opacity-75 whitespace-nowrap">
                                    {item.location}
                                </span>
                            )}
                        </div>
                    </div>
                    {item.description && (
                        <div class="body mt-2">
                            {item.description}
                        </div>
                    )}
                    {item.details && item.details.length > 0 && (
                        <ul class="body mt-2 list-disc pl-5 space-y-1">
                            {item.details.map((detail) => <li>{detail}</li>)}
                        </ul>
                    )}
                    {item.subDetails && item.subDetails.length > 0 && (
                        <div class="body mt-2 space-y-3 opacity-85">
                            {item.subDetails.map((detail) => (
                                <div class="flex gap-3 max-md:gap-2">
                                    <div class="flex flex-col items-center shrink-0 mt-2">
                                        <span class="h-3 w-3 rounded-full border border-current bg-transparent" />
                                        <span class="block w-px flex-1 bg-border mt-1" />
                                    </div>
                                    <div class="leading-6 break-words">{detail}</div>
                                </div>
                            ))}
                        </div>
                    )}
                    {item.thesis && (
                        <div class="body italic mt-2 opacity-80">
                            Thesis: {item.thesis}
                        </div>
                    )}
                    {item.subEntries && item.subEntries.length > 0 && (
                        <div class="body mt-4 space-y-4 opacity-95">
                            {item.subEntries.map((sub) => (
                                <div class="flex gap-3 max-md:gap-2">
                                    <div class="flex flex-col items-center shrink-0 mt-1.5">
                                        <span class="h-3 w-3 rounded-full border border-current bg-transparent" />
                                        <span class="block w-px flex-1 bg-border mt-1" />
                                    </div>
                                    <div class="flex-1">
                                        <div class="subentry-header flex justify-between items-start gap-4 mb-1 max-md:flex-col max-md:items-start max-md:gap-1">
                                            <div class="min-w-0">
                                                <h4 class="text-base font-semibold leading-6 break-words">{sub.title}</h4>
                                                {sub.subtitle && (
                                                    <div class="body opacity-90 break-words whitespace-normal">{sub.subtitle}</div>
                                                )}
                                            </div>
                                            <div class="text-right flex flex-col items-end gap-1 max-md:items-start max-md:text-left">
                                                {sub.period && (
                                                    <span class="body-sm font-semibold opacity-75 whitespace-nowrap">{sub.period}</span>
                                                )}
                                                {sub.location && (
                                                    <span class="body-sm opacity-75 whitespace-nowrap">{sub.location}</span>
                                                )}
                                            </div>
                                        </div>
                                        {sub.description && (
                                            <div class="body mt-1">{sub.description}</div>
                                        )}
                                    </div>
                                </div>
                            ))}
                        </div>
                    )}
                </div>
            </div>
        ))
    }
</div>
