---
import Tag from "./Tag.astro";
import Icon from "./Icon.astro";

const contentImages = import.meta.glob<{ default: ImageMetadata }>("/src/content/**/*.{png,jpg,jpeg,webp,gif}", {
    eager: true,
});

interface Props {
    title: string;
    href: string;
    description?: string;
    date?: string;
    authors?: string;
    extraInput?: string;
    tags?: string[];
    externalUrl?: string;
    image?: string;
    imageAlt?: string;
    imageWidth?: string;
    imageHeight?: string;
    imagePosition?: "left" | "center" | "right";
}

const {
    title,
    href,
    description,
    date,
    authors,
    extraInput,
    tags,
    externalUrl,
    image,
    imageAlt,
    imageWidth,
    imageHeight,
    imagePosition = "left",
} = Astro.props;
const previewImage = image && contentImages[image]?.default?.src ? contentImages[image].default.src : image;
const previewStyle = [
    imageWidth ? `--preview-width: ${imageWidth}` : "",
    imageHeight ? `--preview-max-height: ${imageHeight}` : "",
].filter(Boolean).join("; ");
---

<article class="card">
    <div class="card-content">
        <a href={href} class="card-title">{title}</a>

        <div class="card-meta">
            {date && (
                <span class="flex items-center gap-1">
                    <Icon name="Calendar" size={24} />
                    <span>{date}</span>
                </span>
            )}
            {authors && (
                <span class="flex items-center gap-1">
                    <Icon name="User" size={24} />
                    <span>{authors}</span>
                </span>
            )}
            {extraInput && (
                <span class="flex items-center gap-1">
                    <Icon name="Institution" size={24} />
                    <span>{extraInput}</span>
                </span>
            )}
        </div>

        {
            tags && tags.length > 0 && (
                <div class="flex gap-2 flex-wrap mb-3">
                    {tags.map((tag) => (
                        <Tag name={tag} size="sm" />
                    ))}
                </div>
            )
        }

        {description && <p class="card-desc">{description}</p>}

        {previewImage && (
            <a href={href} class={`card-preview card-preview-${imagePosition}`} style={previewStyle}>
                <img
                    src={previewImage}
                    alt={imageAlt || `Preview for ${title}`}
                    class="card-preview-image"
                    loading="lazy"
                    decoding="async"
                />
            </a>
        )}
    </div>

    {
        href && (
            <div class="flex-shrink-0">
                <a href={href} class="card-link">
                    Read more
                </a>
            </div>
        )
    }
</article>
