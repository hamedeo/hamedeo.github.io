---
import { SOCIALS, SOCIAL_ICONS } from "../../config";
import { getCollection } from "astro:content";
import Icon from "../ui/Icon.astro";
import { Image } from 'astro:assets';

const activeSocials = SOCIALS.filter((s) => s.isActive);
const bioCollection = await getCollection("bio");
const bio = bioCollection[0]?.data;
const institutionLines = bio?.institution
    ?.split(/\r?\n/)
    .map((line) => line.trim())
    .filter(Boolean) ?? [];
const workplace = institutionLines[0];
const location = institutionLines.slice(1).join(", ");
const socialLabels: Record<string, string> = {
    Github: "Explore my GitHub",
    Mail: "Email me directly",
    LinkedIn: "Connect on LinkedIn",
    WhatsApp: "Contact me via WhatsApp",
    Cal: "Arrange a meeting",
};
const socialLabel = (name: string) => socialLabels[name] ?? name;
---

<aside class="sidebar max-lg:flex-row max-lg:flex-wrap max-lg:gap-3 max-md:gap-2">
    <div class="flex flex-col items-center text-center max-lg:flex-row max-lg:text-left max-lg:gap-3 max-lg:items-center max-md:gap-2">
        {bio?.avatar && (
            <Image
                src={`/${bio.avatar}`}
                alt={`Avatar of ${bio.name}`}
                width={160}
                height={160}
                densities={[1.5, 2]} 
                format="webp"
                class="sidebar-avatar mb-4 max-lg:mb-0 max-lg:mr-4"
                loading="eager"
                data-kaleidocycle-profile-trigger
                role="button"
                tabindex="0"
                aria-label="Open interactive Kaleidocycle"
            />
        )}
        <div class="flex flex-col items-center max-lg:items-center">
            {bio?.name && <h1 class="sidebar-name">{bio.name}</h1>}
            {(workplace || location) && (
                <div class="sidebar-details">
                    {workplace && (
                        <p class="sidebar-info">
                            <Icon name="Work" size={24} />
                            {workplace}
                        </p>
                    )}
                    {location && (
                        <p class="sidebar-info">
                            <Icon name="Location" size={24} />
                            {location}
                        </p>
                    )}
                </div>
            )}
            {bio?.shortBio && (
                <p class="sidebar-bio mt-2 max-md:hidden" style="white-space: pre-line;">{bio.shortBio}</p>
            )}
            <div class="flex gap-1 flex-wrap items-center justify-center max-lg:justify-start mt-3">
                {activeSocials.map((social) => (
                    social.name === "Github" ? (
                        <>
                            <a
                                href={social.href}
                                aria-label={social.linkTitle}
                                data-label={socialLabel(social.name)}
                                data-contact={social.name}
                                target="_blank"
                                rel="noreferrer"
                                class="social-link social-link-github"
                            >
                                <Icon name={SOCIAL_ICONS[social.name] || social.name} size={24} />
                            </a>
                            <button
                                type="button"
                                aria-label="Save Hamed Abdollahi’s contact"
                                title="Save Contact Information"
                                data-save-contact
                                data-contact="SaveContact"
                                class="social-link social-link-save-contact"
                            >
                                <Icon name="UserPlus" size={24} />
                            </button>
                        </>
                    ) : (
                        <a
                            href={social.href}
                            aria-label={social.linkTitle}
                            data-label={socialLabel(social.name)}
                            data-contact={social.name}
                            target="_blank"
                            rel="noreferrer"
                            class="social-link"
                        >
                            <Icon name={SOCIAL_ICONS[social.name] || social.name} size={24} />
                        </a>
                    )
                ))}
            </div>
            <div class="kaleidocycle-dock" data-kaleidocycle-dock aria-hidden="true"></div>
        </div>
    </div>
    <div class="contact-overlay" aria-hidden="true">
        {activeSocials.map((social) => (
            <span class="contact-message" data-contact={social.name}>
                {socialLabel(social.name)}
            </span>
        ))}
        <span class="contact-message" data-contact="SaveContact">
            Save Contact Information
        </span>
    </div>
</aside>

<script>
    type SidebarWindow = Window &
        typeof globalThis & {
            __saveContactHandler?: (event: MouseEvent) => void;
        };

    const sidebarWindow = window as SidebarWindow;
    const VCARD_URL = "/vcf/Hamed_Abdollahi.vcf";
    const VCARD_FILE_NAME = "Hamed_Abdollahi.vcf";
    const VCARD_TIME_ZONE = "Europe/Amsterdam";
    const MEETING_NOTE_PATTERN = /When we met:[^\\\r\n]*/;

    function markTouchDevice() {
        const hasTouch =
            navigator.maxTouchPoints > 0 ||
            "ontouchstart" in window;

        document.documentElement.classList.toggle("touch-device", hasTouch);
    }

    markTouchDevice();
    document.addEventListener("astro:page-load", markTouchDevice);
    document.addEventListener(
        "pointerdown",
        (event) => {
            if (event.pointerType === "touch") {
                document.documentElement.classList.add("touch-device");
            }
        },
        { capture: true, passive: true },
    );

    function formatContactTime(date: Date) {
        const parts = new Intl.DateTimeFormat("en-CA", {
            timeZone: VCARD_TIME_ZONE,
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit",
            hourCycle: "h23",
        }).formatToParts(date);

        const value = (type: Intl.DateTimeFormatPartTypes) =>
            parts.find((part) => part.type === type)?.value ?? "";

        return `${value("year")}-${value("month")}-${value("day")} ${value("hour")}:${value("minute")}:${value("second")} (${VCARD_TIME_ZONE})`;
    }

    if (sidebarWindow.__saveContactHandler) {
        document.removeEventListener("click", sidebarWindow.__saveContactHandler);
    }

    sidebarWindow.__saveContactHandler = async (event: MouseEvent) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const saveButton = target.closest<HTMLButtonElement>("[data-save-contact]");
        if (!saveButton) return;

        event.preventDefault();
        saveButton.disabled = true;

        try {
            const response = await fetch(VCARD_URL, { cache: "no-store" });
            if (!response.ok) throw new Error("Unable to load contact card.");

            const meetingTime = formatContactTime(new Date());
            const vcard = (await response.text()).replace(
                MEETING_NOTE_PATTERN,
                `When we met: ${meetingTime}`,
            );
            const blobUrl = URL.createObjectURL(
                new Blob([vcard], { type: "text/vcard;charset=utf-8" }),
            );
            const downloadLink = document.createElement("a");

            downloadLink.href = blobUrl;
            downloadLink.download = VCARD_FILE_NAME;
            downloadLink.hidden = true;
            document.body.append(downloadLink);
            downloadLink.click();
            downloadLink.remove();

            window.setTimeout(() => URL.revokeObjectURL(blobUrl), 60_000);
        } catch (error) {
            console.error("Contact card download failed.", error);
        } finally {
            saveButton.disabled = false;
        }
    };

    document.addEventListener("click", sidebarWindow.__saveContactHandler);
</script>
