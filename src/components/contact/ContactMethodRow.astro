---
import Icon from "../ui/Icon.astro";

interface Props {
    title: string;
    href: string;
    cta: string;
    icon: string;
    external?: boolean;
    ariaLabel?: string;
}

const { title, href, cta, icon, external = false, ariaLabel } = Astro.props;
---

<a
    class="contact-row"
    href={href}
    aria-label={ariaLabel ?? cta}
    {...(external ? { target: "_blank", rel: "noreferrer noopener" } : {})}
>
    <div class="contact-row-icon" aria-hidden="true">
        <Icon name={icon} size={22} />
    </div>
    <div class="contact-row-copy">
        <h3 class="contact-row-title">{title}</h3>
    </div>
</a>
