---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PAGES, SOCIALS } from "../../config";
import MeetingOptionCard from "./MeetingOptionCard.astro";
import ContactMethodRow from "./ContactMethodRow.astro";

const pageKey = Astro.props.pageKey ?? "contact";
const page = (PAGES as any)[pageKey] ?? PAGES.contact;

const cvEntry = await getEntry("cv", "cv");
const phone = cvEntry?.data.phone ?? "+31 622410181";

const socialByName = Object.fromEntries(SOCIALS.map((social) => [social.name, social]));
const emailHref = socialByName.Mail?.href ?? "mailto:hamed.abdollahi@outlook.com";
const linkedinHref = socialByName.LinkedIn?.href ?? "https://www.linkedin.com/in/hamedeo";
const whatsappHref = socialByName.WhatsApp?.href ?? "https://api.whatsapp.com/send/?phone=31622410181";
const calHref = socialByName.Cal?.href ?? "https://cal.eu/hamedeo";
const githubHref = socialByName.Github?.href ?? "https://github.com/hamedeo";
const lettuceMeetHref = "PASTE_LETTUCEMEET_LINK_HERE";
---

<BaseLayout title={page.title}>
    <header class="page-header">
        <h1 class="page-title">{page.title}</h1>
        <p class="page-subtitle">{page.subtitle}</p>
    </header>

    <div class="contact-page container-narrow">
        <section class="contact-hero section">
            <p class="contact-intro">
                For a calm, low-pressure first step, I like meeting around coffee, a ride, or a walk.
                Weekends usually work best.
            </p>

            <div class="meeting-option-grid" aria-label="Ways to meet casually">
                <MeetingOptionCard
                    title="Coffee"
                    description="A casual coffee to talk about engineering, ideas, work, or anything in between."
                    icon="Calendar"
                    accent="coffee"
                />
                <MeetingOptionCard
                    title="Cycle with me"
                    description="A relaxed weekend ride around Eindhoven or nearby, with space for conversation and movement."
                    icon="Location"
                    accent="cycle"
                />
                <MeetingOptionCard
                    title="Walk"
                    description="A walk for two people or a small group, simple, informal, and human."
                    icon="User"
                    accent="walk"
                />
            </div>

            <div class="lettucemeet-cta">
                <div>
                    <p class="lettucemeet-eyebrow">Simple scheduling</p>
                    <p class="lettucemeet-copy">
                        I use LettuceMeet to find a shared time in a simple and low-pressure way.
                    </p>
                </div>
                <a
                    href={lettuceMeetHref}
                    class="btn contact-main-cta"
                    aria-label="Arrange a meeting with LettuceMeet"
                >
                    Arrange with LettuceMeet
                </a>
            </div>
        </section>

        <section class="section contact-methods">
            <h2 class="section-title">Other ways to reach me</h2>

            <div class="contact-method-list">
                <ContactMethodRow
                    title="Email / Call"
                    description="Prefer a direct route? Send me an email or call me if it is easier to explain the context in words."
                    href={emailHref}
                    cta="Email me"
                    secondaryCta="Call me"
                    secondaryHref={`tel:${phone.replaceAll(" ", "")}`}
                    icon="Mail"
                    secondaryAriaLabel={`Call Hamed Abdollahi at ${phone}`}
                />

                <ContactMethodRow
                    title="WhatsApp"
                    description="For quicker coordination, WhatsApp works well. Simple, informal, and practical."
                    href={whatsappHref}
                    cta="Message on WhatsApp"
                    icon="WhatsApp"
                    external
                />

                <ContactMethodRow
                    title="Calendar"
                    description="If you already know you want a focused conversation, choose a time directly."
                    href={calHref}
                    cta="Book a meeting"
                    icon="Calendar"
                    external
                />

                <ContactMethodRow
                    title="LinkedIn"
                    description="For professional context, shared interests, or future collaboration, LinkedIn is the best place to connect."
                    href={linkedinHref}
                    cta="Connect on LinkedIn"
                    icon="LinkedIn"
                    external
                />

                <ContactMethodRow
                    title="GitHub"
                    description="If you want to see what I build, write, and share, GitHub is the easiest place to start."
                    href={githubHref}
                    cta="View GitHub"
                    icon="Github"
                    external
                />
            </div>
        </section>
    </div>
</BaseLayout>
