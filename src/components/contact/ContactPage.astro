---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PAGES, SOCIALS } from "../../config";
import MeetingOptionCard from "./MeetingOptionCard.astro";
import ContactMethodRow from "./ContactMethodRow.astro";

const pageKey = Astro.props.pageKey ?? "contact";
const page = (PAGES as any)[pageKey] ?? PAGES.contact;

const cvEntry = await getEntry("cv", "cv");
const phone = cvEntry?.data.phone ?? "+31 622410181";

const socialByName = Object.fromEntries(SOCIALS.map((social) => [social.name, social]));
const emailHref = socialByName.Mail?.href ?? "mailto:hamed.abdollahi+website@outlook.com";
const linkedinHref = socialByName.LinkedIn?.href ?? "https://www.linkedin.com/in/hamedeo";
const whatsappHref = socialByName.WhatsApp?.href ?? "https://api.whatsapp.com/send/?phone=31622410181";
const calHref = socialByName.Cal?.href ?? "https://cal.eu/hamedeo";
const githubHref = socialByName.Github?.href ?? "https://github.com/hamedeo";
const tallyHref =
    "https://tally.so/embed/b5GyQ1?alignLeft=1&transparentBackground=1";
---

<BaseLayout title={page.title}>
    <header class="page-header">
        <h1 class="page-title">{page.title}</h1>
        <p class="page-subtitle">{page.subtitle}</p>
    </header>

    <div class="contact-page container-narrow">
        <section class="section contact-methods">
            <h2 class="section-title contact-section-title">Do you want to discuss new projects or opportunities?</h2>
            <div class="contact-method-list">
                <ContactMethodRow
                    title="Email"
                    description="Share the relevant details, and I will respond shortly."
                    href={emailHref}
                    cta="Email me"
                    icon="Mail"
                />

                <ContactMethodRow
                    title="Phone"
                    description="For matters better discussed directly, please call me."
                    href={`tel:${phone.replaceAll(" ", "")}`}
                    cta="Call me"
                    icon="Phone"
                    ariaLabel={`Call Hamed Abdollahi at ${phone}`}
                />

                <ContactMethodRow
                    title="WhatsApp"
                    description="Send me a quick message for simple and direct communication."
                    href={whatsappHref}
                    cta="Message on WhatsApp"
                    icon="WhatsApp"
                    external
                />

                <ContactMethodRow
                    title="Calendar"
                    description="Schedule an online meeting at a convenient time."
                    href={calHref}
                    cta="Book a meeting"
                    icon="Calendar"
                    external
                />

                <ContactMethodRow
                    title="LinkedIn"
                    description="Connect for professional discussions and potential collaboration."
                    href={linkedinHref}
                    cta="Connect on LinkedIn"
                    icon="LinkedIn"
                    external
                />

                <ContactMethodRow
                    title="GitHub"
                    description="Explore my projects, technical work, and contributions."
                    href={githubHref}
                    cta="View GitHub"
                    icon="Github"
                    external
                />
            </div>
        </section>

        <section class="contact-hero section">
            <p class="contact-intro">
                As Nietzsche once said—All truly great thoughts are conceived while walking. Coffee, a walk, or a weekend cycle can be easier than a formal call.
            </p>

            <!-- <div class="meeting-option-grid" aria-label="Ways to meet casually">
                <MeetingOptionCard
                    title="Coffee"
                    description="A casual coffee to talk about engineering, ideas, work, or anything in between to get sharp for the rest of the day."
                    icon="Coffee"
                    accent="coffee"
                />
                <MeetingOptionCard
                    title="Cycle"
                    description="A ride around Eindhoven, to ride about things! Another city? I might be up for it, but let's talk first."
                    icon="Cycle"
                    accent="cycle"
                />
                <MeetingOptionCard
                    title="Walk"
                    description="Let's walk, talk, and share ideas. As Nietzsche once said—All truly great thoughts are conceived while walking."
                    icon="Walk"
                    accent="walk"
                />
            </div>
 -->
            <div class="contact-form-embed" role="region" aria-label="Embedded contact form">
                <iframe
                    src={tallyHref}
                    title="Embedded contact form"
                    loading="eager"
                    referrerpolicy="no-referrer"
                />
            </div>
        </section>
    </div>
</BaseLayout>
