---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PAGES, SOCIALS } from "../../config";
import MeetingOptionCard from "./MeetingOptionCard.astro";
import ContactMethodRow from "./ContactMethodRow.astro";
import Icon from "../ui/Icon.astro";
import "../../styles/pages/contact.css";

const pageKey = Astro.props.pageKey ?? "contact";
const page = (PAGES as any)[pageKey] ?? PAGES.contact;

const cvEntry = await getEntry("cv", "cv");
const phone = cvEntry?.data.phone ?? "+31 622410181";

const socialByName = Object.fromEntries(SOCIALS.map((social) => [social.name, social]));
const emailHref = socialByName.Mail?.href ?? "mailto:deotrovatore@outlook.com";
const linkedinHref = socialByName.LinkedIn?.href ?? "https://www.linkedin.com/in/hamedeo";
const whatsappHref = socialByName.WhatsApp?.href ?? "https://api.whatsapp.com/send/?phone=31622410181";
const calHref = socialByName.Cal?.href ?? "https://cal.com/hamedeo";
const githubHref = socialByName.Github?.href ?? "https://github.com/hamedeo";
const contactDetailsTallyHref =
    "https://tally.so/embed/QKWbMG?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1";
const meetingTimeTallyHref =
    "https://tally.so/embed/b5GyQ1?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1";
---

<BaseLayout title={page.title}>
    <Fragment slot="head">
        <script async src="https://tally.so/widgets/embed.js" onload="window.__loadTallyEmbeds?.()"></script>
        <script is:inline>
            const loadTallyEmbeds = () => {
                if (typeof window.Tally?.loadEmbeds === "function") {
                    window.Tally.loadEmbeds();
                    return;
                }

                document
                    .querySelectorAll('iframe[data-tally-src]:not([src])')
                    .forEach((iframe) => {
                        iframe.src = iframe.dataset.tallySrc;
                    });
            };

            if (window.__loadTallyEmbeds) {
                document.removeEventListener("astro:page-load", window.__loadTallyEmbeds);
            }

            window.__loadTallyEmbeds = loadTallyEmbeds;
            document.addEventListener("astro:page-load", loadTallyEmbeds);
            window.addEventListener("load", loadTallyEmbeds, { once: true });
        </script>
    </Fragment>

    <header class="page-header">
        <h1 class="page-title">{page.title}</h1>
        <p class="page-subtitle">{page.subtitle}</p>
    </header>

    <div class="contact-page container-narrow">
        <section class="section contact-methods">
            <button
                type="button"
                class="contact-main-cta contact-row"
                data-save-contact
            >
                <span class="contact-row-icon" aria-hidden="true">
                    <Icon name="UserPlus" size={22} />
                </span>
                <span class="contact-row-title">Add to Contacts</span>
            </button>
            <div class="contact-method-list">
                <ContactMethodRow
                    title="Email"
                    href={emailHref}
                    cta="Email me"
                    icon="Mail"
                />

                <ContactMethodRow
                    title="Phone"
                    href={`tel:${phone.replaceAll(" ", "")}`}
                    cta="Call me"
                    icon="Phone"
                    ariaLabel={`Call Deo Trovatore at ${phone}`}
                />

                <ContactMethodRow
                    title="WhatsApp"
                    href={whatsappHref}
                    cta="Message on WhatsApp"
                    icon="WhatsApp"
                    external
                />

                <ContactMethodRow
                    title="LinkedIn"
                    href={linkedinHref}
                    cta="Connect on LinkedIn"
                    icon="LinkedIn"
                    external
                />

                <ContactMethodRow
                    title="Schedule a meeting"
                    href={calHref}
                    cta="Book a meeting"
                    icon="Calendar"
                    external
                />

                <ContactMethodRow
                    title="GitHub"
                    href={githubHref}
                    cta="View GitHub"
                    icon="Github"
                    external
                />
            </div>
            <h2 class="section-title contact-section-title contact-projects-title">Let's Talk Projects</h2>
            <section class="contact-form-embed" aria-label="Share your contact details">
                <iframe
                    class="tally-embed"
                    data-tally-src={contactDetailsTallyHref}
                    loading="lazy"
                    width="100%"
                    height="532"
                    frameborder="0"
                    marginheight="0"
                    marginwidth="0"
                    title="Share your contact details"
                ></iframe>
            </section>
        </section>

        <section class="contact-hero section">
            <h2 class="section-title contact-section-title">Or Discuss Them in Motion</h2>
            <p class="contact-intro">
                "All truly great thoughts are conceived while walking." — Friedrich Nietzsche
            </p>
            <p class="contact-intro">
                If you prefer to be different, coffee, a walk, or a weekend cycle can often be much easier than a formal call.
            </p>

            <section class="meeting-form-embed" aria-label="Suggest a time to meet">
                <iframe
                    class="tally-embed"
                    data-tally-src={meetingTimeTallyHref}
                    loading="lazy"
                    width="100%"
                    height="508"
                    frameborder="0"
                    marginheight="0"
                    marginwidth="0"
                    title="Suggest a time to meet"
                ></iframe>
            </section>
        </section>
    </div>
</BaseLayout>
