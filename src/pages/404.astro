---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/pages/not-found.css";
---

<BaseLayout
    title="404 — Thread Not Found"
    appendSiteName={false}
    description="The requested page could not be found."
    robots="noindex, nofollow"
>
    <main class="not-found-page" aria-labelledby="not-found-title">
        <figure class="not-found-figure">
            <img
                src="/images/gdt-website-404.svg"
                alt="GD&T-style technical drawing inspired by the website interface."
                width="720"
                height="520"
                loading="eager"
                decoding="async"
            />
        </figure>

        <div class="not-found-copy">
            <p class="not-found-label">ERROR 404</p>
            <h1 id="not-found-title" class="not-found-title">THREAD NOT FOUND</h1>
            <p class="not-found-description">
                This page did not meet the drawing specification.
            </p>
            <a class="btn not-found-home-link" href="/">
                Return to homepage
            </a>
        </div>
    </main>
</BaseLayout>
