---
import { getCollection } from "astro:content";
import BaseDetail from "../../layouts/BaseDetail.astro";
import { PAGES } from "../../config";
import R3plyComments from "../../components/content/R3plyComments.astro";
import "../../styles/pages/talks.css";


if (PAGES.talks.isActive === false) {
    return Astro.redirect("/404");
}

export async function getStaticPaths() {
    if (PAGES.talks.isActive === false) return [];
    const talks = (await getCollection("talks")).filter((talk: any) => talk.data.hidden !== true);
    return talks.map((talk: any) => ({
        params: { id: talk.id },
        props: { talk },
    }));
}

const { id } = Astro.params;
---

<BaseDetail collection="talks" id={id}>
    <div slot="footer" class="container-narrow">
        <R3plyComments />
    </div>
</BaseDetail>
