    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "sharp@0.34.5": true
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "docxtemplater": "^3.69.0",
